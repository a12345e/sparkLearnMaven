# ---------------------------------------------------------------------------
# The external Hadoop / HDFS / Hive system.
#
# This file lives OUTSIDE the build. Nothing here is packaged into the jar, so
# one artifact runs against dev, staging and production. Copy it, fill it in,
# and point the job at your copy:
#
#   -Dhadood.config=/etc/ontology/cluster.properties
#   HADOOD_CONFIG=/etc/ontology/cluster.properties
#
# Read by com.example.ontologyprocessor.hadood.ClusterConfig. Blank values are
# treated as absent, so an unused key can be left empty rather than deleted.
# ---------------------------------------------------------------------------

# --- HDFS (hadoop-hdfs 3.1.3 client) ---------------------------------------

# The external namenode. Becomes fs.defaultFS.
hdfs.uri = hdfs://namenode.example.com:8020

# The cluster own configuration directory, holding core-site.xml and
# hdfs-site.xml (yarn-site.xml is picked up too if present). Optional, but the
# usual way to inherit HA namenode settings rather than restate them here.
# core-site.xml must exist if this is set; the others may be missing.
hadoop.conf.dir = /etc/hadoop/conf

# Who to act as on an unsecured cluster. Ignored when Kerberos is on.
hadoop.user.name = ontology

# --- Hive (hive 3.1.3) ------------------------------------------------------

# The external metastore. Setting this is what turns Hive support on.
hive.metastore.uris = thrift://metastore.example.com:9083

# Directory holding the cluster hive-site.xml. Optional.
hive.conf.dir = /etc/hive/conf

# Spark 3.5 embeds Hive 2.3.9 for its own internals, so it cannot talk to a
# Hive 3.1.3 metastore on the classpath alone: it loads the 3.1.3 client in an
# isolated classloader instead. Defaults to 3.1.3, and because that is not the
# embedded version, hive.metastore.jars.path is then required.
hive.metastore.version = 3.1.3

# builtin | path | maven. Defaults to "path" when a jars path is given below.
hive.metastore.jars = path

# Where the Hive 3.1.3 client jars are, on every node. A directory glob.
# Set hive.metastore.jars = maven instead to let Spark fetch them.
hive.metastore.jars.path = file:///opt/hive-3.1.3/lib/*

# Warehouse root on the external cluster. Becomes spark.sql.warehouse.dir.
hive.warehouse.dir = hdfs://namenode.example.com:8020/warehouse/tablespace/managed/hive

# --- Security ---------------------------------------------------------------

# simple | kerberos
security.authentication = simple

# Required when the cluster is kerberised; ClusterConfig.login() refuses to
# continue on a secured cluster without them.
kerberos.principal =
kerberos.keytab =

# --- Escape hatches ---------------------------------------------------------

# Anything Hadoop understands, prefix stripped and applied to the Configuration
# and to Spark as spark.hadoop.<key>. Use for cluster quirks that do not
# deserve a named key of their own.
#
# hadoop.opt.dfs.client.use.datanode.hostname = true
# hadoop.opt.ipc.client.fallback-to-simple-auth-allowed = true

# Anything starting with spark. reaches Spark verbatim, and wins over the
# settings derived above.
#
# spark.sql.sources.partitionOverwriteMode = dynamic
