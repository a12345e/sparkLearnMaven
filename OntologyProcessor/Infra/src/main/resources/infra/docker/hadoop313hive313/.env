# Versions baked into the image at build time. Changing either needs
# `docker compose up -d --build`.
HADOOP_VERSION=3.1.3
HIVE_VERSION=3.1.3
# 0.10.1 is the Tez release built against Hadoop 3.1.3. It is installed but
# NOT the default engine: Tez local mode and Hive 3.1.3 disagree about split
# counts (see conf/hive-site.xml), so queries run on MapReduce instead. Tez is
# kept because it is the only engine Hive 4 has, and because it works against a
# real YARN cluster.
TEZ_VERSION=0.10.1

# Tez runs inside the HiveServer2 JVM. Set false only if you point the stack at
# a YARN cluster of your own.
TEZ_LOCAL_MODE=true

HADOOP_HEAPSIZE=1024

# Host ports. Change these if something already listens on them.
NAMENODE_HTTP_PORT=9870
NAMENODE_RPC_PORT=8020
DATANODE_HTTP_PORT=9864
DATANODE_DATA_PORT=9866
POSTGRES_PORT=5432
METASTORE_PORT=9083
HIVESERVER2_PORT=10000
HIVESERVER2_WEBUI_PORT=10002

# The name the DataNode registers with the NameNode under, and therefore
# the name a client that sets dfs.client.use.datanode.hostname=true will
# dial for blocks. "localhost" is right for a Spark job running on this
# machine: it resolves to the published DATANODE_DATA_PORT. Set it to
# "datanode" instead if every client lives on the compose network.
DATANODE_ADVERTISED_HOST=localhost
