# Pin this to whatever you are standardising on. Your other projects here use
# 7.17.13 / 7.13.1; this stack is pinned to 8.19.4.
ES_VERSION=8.19.4

# Heap per node. These are test clusters — 512m is plenty, and 256m works for
# trivial ones. Budget ~1.5GB of RAM per cluster in practice, which is what
# actually limits how many you can run.
ES_HEAP=512m

# The network all clusters join so remote reindex can reach across.
SHARED_NETWORK=es-shared

# Which sources a cluster will accept a remote reindex from. Static setting:
# a change needs the clusters restarted.
REINDEX_WHITELIST=es-*:9200
